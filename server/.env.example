PORT=3001

# Chave de API da Anthropic (Claude) — usada pelos agentes com provedor "anthropic"
ANTHROPIC_API_KEY=

# Opcional: modelo padrão da Anthropic (pode ser sobrescrito por agente)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Chave de API da OpenRouter (https://openrouter.ai/keys) — usada pelos agentes com
# provedor "openrouter", que dá acesso a diversos modelos (OpenAI, Meta, Google, etc.)
OPENROUTER_API_KEY=

# Opcional: modelo padrão da OpenRouter (pode ser sobrescrito por agente)
OPENROUTER_MODEL=openai/gpt-4o-mini
